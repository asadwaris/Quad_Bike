df["gttr_clean"] = df["gttr name"].fillna("").str.lower().str.strip()

# Step 2: encode both columns in one batch each (with e5 prefix)
emb_name = model.encode(
    ["query: " + t for t in df["name_clean"]],
    normalize_embeddings=True,
    batch_size=64,
    show_progress_bar=True,
)
emb_gttr = model.encode(
    ["query: " + t for t in df["gttr_clean"]],
