import pandas as pd, numpy as np
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score
from xgboost import XGBClassifier

data = sdf.copy()
data['carRentalDays'] = data['carRentalDays'].fillna(0)
data = data.dropna(subset=['Final_Classification'])
data['target'] = (data['Final_Classification'] == 'Match').astype(int)

for c in ['name_match', 'date_match']:
    data[c] = data[c].astype(int)

X = data.drop(columns=['ind', 'Final_Classification', 'target'])
y = data['target']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=42)

spw = (y_train == 0).sum() / (y_train == 1).sum()

model = XGBClassifier(
    n_estimators=300, max_depth=4, learning_rate=0.1,
    subsample=0.9, colsample_bytree=0.9,
    scale_pos_weight=spw, eval_metric='logloss', random_state=42)
model.fit(X_train, y_train)

# --- probabilities ---
proba_test = model.predict_proba(X_test)[:, 1]   # P(Match)
pred = (proba_test >= 0.5).astype(int)

print("Confusion matrix:\n", confusion_matrix(y_test, pred), "\n")
print(classification_report(y_test, pred))
print("ROC-AUC:", round(roc_auc_score(y_test, proba_test), 4), "\n")
print("Feature importance:\n",
      pd.Series(model.feature_importances_, index=X.columns).sort_values(ascending=False))



# score full dataset
data['match_probability'] = model.predict_proba(X)[:, 1]
data['predicted_label'] = np.where(data['match_probability'] >= 0.5, 'Match', 'No Match')

# confusion matrix on ALL rows (actual vs predicted)
print("Confusion matrix (full dataset):\n",
      confusion_matrix(data['target'], (data['match_probability'] >= 0.5).astype(int)), "\n")

print(classification_report(
    data['target'],
    (data['match_probability'] >= 0.5).astype(int),
    target_names=['No Match', 'Match']))

# final output table
result = data[['ind', 'Final_Classification', 'predicted_label', 'match_probability']]
result


