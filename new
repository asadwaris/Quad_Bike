def sim(a, b, prefix):
    e = model.encode([prefix + a, prefix + b], normalize_embeddings=True)
    return float(np.dot(e[0], e[1]))

print("with prefix:   ", sim("Uber ride",  "office rent payment", "query: "))
print("without prefix:", sim("Uber ride",  "office rent payment", ""))
