def to_brand(text):
    if not isinstance(text, str):
        return None
    toks = re.sub(r'[^a-z]', ' ', text.lower()).split()
    for tok in toks:
        if len(tok) < 4:
            continue
        for canon, variants in BRANDS.items():
            for v in variants:
                if v.startswith(tok) or tok.startswith(v):
                    return canon
    return None

