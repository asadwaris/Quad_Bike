import ast

def to_set(v):
    if isinstance(v, (set, frozenset)):
        return set(v)
    if isinstance(v, (list, tuple)):
        return set(v)
    if isinstance(v, str):
        v = v.strip()
        if not v or v in ('set()', 'nan', '{}'):
            return set()
        try:
            return {int(x) for x in ast.literal_eval(v)}
        except Exception:
            return {int(x) for x in re.findall(r'\d+', v)}
    return set()

