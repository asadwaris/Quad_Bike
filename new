import re
import pandas as pd

BRANDS = {
    'NATIONAL':  ['national'],
    'ENTERPRISE':['enterprise', 'enterpri'],
    'HERTZ':     ['hertz'],
    'BUDGET':    ['budget'],
    'SIXT':      ['sixt'],
    'AVIS':      ['avis'],
    'THRIFTY':   ['thrifty'],
    'DOLLAR':    ['dollar'],
    'FOX':       ['fox'],
    'PAYLESS':   ['payless'],
    'EASIRENT':  ['easirent'],
    'ALAMO':     ['alamo'],
    'ADVANTAGE': ['advantage', 'advantag'],
}

def parse_f2_code(s):
    if not isinstance(s, str):
        return None
    s = s.strip().lstrip('*').strip()
    if not s:
        return None
    parts = s.split()
    return parts[0] if len(parts) >= 2 else (s[:-3] if len(s) > 3 else s)

def to_brand(text):
    if not isinstance(text, str):
        return None
    for tok in re.sub(r'[^a-z]', ' ', text.lower()).split():
        if len(tok) < 4:
            continue
        for canon, variants in BRANDS.items():
            for v in variants:
                if v.startswith(tok) or tok.startswith(v):
                    return canon
    return None

