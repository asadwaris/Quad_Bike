import re
import pandas as pd

BRANDS = {
    'HERTZ':      ['hertz'],
    'ENTERPRISE': ['enterprise'],
    'AVIS':       ['avis'],
    'NATIONAL':   ['national'],
    'BUDGET':     ['budget'],
    'ALAMO':      ['alamo'],
    'DOLLAR':     ['dollar'],
    'THRIFTY':    ['thrifty'],
    'SIXT':       ['sixt'],
    'EUROPCAR':   ['europcar'],
    'PAYLESS':    ['payless'],
    'FOX':        ['fox'],
    'ADVANTAGE':  ['advantage'],
    'ACE':        ['ace'],
}

def parse_f2_code(s):
    """'*ENTERPRILGA' -> 'ENTERPRI'   ;   '*HERTZ   TUL' -> 'HERTZ'"""
    if not isinstance(s, str):
        return None
    s = s.strip().lstrip('*').strip()
    if not s:
        return None
    parts = s.split()
    if len(parts) >= 2:
        return parts[0]
    return s[:-3] if len(s) > 3 else s      # trailing 3 chars = airport code

def to_brand(text):
    """token-level prefix match, handles truncation both directions"""
    if not isinstance(text, str):
        return None
    toks = re.sub(r'[^a-z]', ' ', text.lower()).split()
    for tok in toks:
        if len(tok) < 3:
            continue
        for canon, variants in BRANDS.items():
            for v in variants:
                if v.startswith(tok) or tok.startswith(v):
                    return canon
    return None




