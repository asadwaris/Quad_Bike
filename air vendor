_NOISE = re.compile(
    r"\b(airlines?|airline|airways?|airway|air ?lines?|aviation|"
    r"flight|flights|fly|jet|jets|group|holdings|"
    r"inc|llc|ltd|pvt|private|limited|corp|corporation|company|co|"
    r"international|intl|the|of|and)\b"
)
_PAY = re.compile(r"\b(sp|sq|tst|pos|pmt|payment|purchase|debit|credit|card|"
                  r"www|com|http[s]?|inflight|inflt|wifi|baggage|bag ?fee|"
                  r"seat|upgrade|ancillary|kiosk|onboard)\b")

# IATA ticket number: 3-digit airline prefix + 10-digit serial
_TICKET = re.compile(r"\b(\d{3})[\s\-]?\d{10}\b")
# kabhi kabhi sirf prefix chipka hota hai naam ke saath: "AMERICAN AIR001..."
_PREFIX_GLUED = re.compile(r"(?<![\d])(\d{3})(?=\d{6,})")


def _norm(s):
    if not isinstance(s, str):
        return ""
    s = s.lower().replace("*", " ").replace("-", " ").replace("/", " ")
    s = re.sub(r"[^a-z0-9\s]", " ", s)
    s = _PAY.sub(" ", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s

def _strip_noise(s):
    s = _NOISE.sub(" ", s)
    s = re.sub(r"\d+", " ", s)          # airline me digits sirf ticket no. hote hain
    return re.sub(r"\s+", " ", s).strip()


