    "delta dental", "delta faucet",
]

_CANON_INDEX = {c[0]: c for c in _CARRIERS}

# regional affiliate -> parent
_REGIONAL_PARENT = {
    "envoy": "american", "piedmont": "american", "psa": "american",
    "skywest": None, "republic": None, "mesa": None,     # multiple parents, ambiguous
    "endeavor": "delta", "horizon": "alaska",
}


def _ticket_prefix(raw):
    """Descriptor me IATA ticket prefix mile to nikaal lo."""
    if not isinstance(raw, str):
        return ""
    digits = re.sub(r"[^\d]", "", raw)
    m = _TICKET.search(raw) or _TICKET.search(digits)
    if m:
        return m.group(1)
    m = _PREFIX_GLUED.search(digits)
    if m and len(digits) >= 11:
        return m.group(1)
    return ""


def _carrier_from_prefix(pfx):
    if not pfx:
        return ""
    for canon, _names, prefixes, _codes in _CARRIERS:
        if pfx in prefixes:
            return canon
    return ""


def _is_non_carrier(nrm):
    padded = f" {nrm} "
    return any(x in padded for x in _NON_CARRIER)


def _carrier(raw):
    """
    Returns (canonical_carrier, confidence)
      confidence: 'ticket' > 'name' > 'code' > ''
    """
    nrm = _norm(raw)
    if not nrm:
        return "", ""

    # 1) ticket prefix sabse strong signal hai
    c = _carrier_from_prefix(_ticket_prefix(raw))
    if c:
        return c, "ticket"

    # 2) non-carrier check name-match se PEHLE
    #    ("american express" ko "american" na bana de)
    if _is_non_carrier(nrm):
        return "__nonair__", "name"

    # 3) name patterns
    padded = f" {nrm} "
    for canon, names, _p, _c in _CARRIERS:
        for n in names:
            if n in padded:
                return canon, "name"

    # 4) regional affiliate
    for reg, parent in _REGIONAL_PARENT.items():
        if reg in padded:
            if parent and REGIONAL_AS_PARENT:
                return parent, "name"
            return f"regional:{reg}", "name"

    # 5) standalone 2-letter code (sirf tab jab string chhoti ho)
    toks = nrm.split()
    if len(toks) <= 2:
        for canon, _n, _p, codes in _CARRIERS:
            if any(t in codes for t in toks):
                return canon, "code"

    return "", ""


