# CELL 4 : LAYER 2  -  LLM (counted)
# ============================================================
_PROMPT = """You are matching airline names from a credit card transaction against an airline name from an invoice system.

The same carrier can look different: abbreviations, typos, missing "Airlines"/"Airways", IATA ticket prefixes or two-letter codes attached, payment-processor text.

Rules:
- An airline is a single company. Airport codes, city names, or route info attached to the name do NOT make it a different vendor. "AMERICAN AIRLINES JFK" and "American Airlines" are the SAME.
- Typos and truncations are still the same carrier: "SOUTWES" and "Southwest Airlines" are the SAME.
- Similar-sounding but distinct carriers are DIFFERENT: "Air Canada" vs "Air China", "JetBlue" vs "Jet Airways", "Virgin Atlantic" vs "Virgin Australia".
- A travel agency, booking site, GDS, or airport service (Expedia, Sabre, parking, TSA) is NEVER the same as an airline.

Transaction vendor: "{txn}"
Candidate vendor:   "{cand}"

Do these refer to the same airline? Answer with exactly one word: YES or NO."""


def _cache_key(a, b):
    na, nb = _norm(a), _norm(b)
    return (na, nb) if na <= nb else (nb, na)


def llm_match(txn_vendor, cand_vendor, retries=3):
    key = _cache_key(txn_vendor, cand_vendor)
    if key in LLM_CACHE:
        LLM.cache_hits += 1
        return LLM_CACHE[key]

    body = {"anthropic_version": "bedrock-2023-05-31", "max_tokens": 5,
            "temperature": 0,
            "messages": [{"role": "user",
                          "content": _PROMPT.format(txn=txn_vendor, cand=cand_vendor)}]}

    for attempt in range(retries):
        try:
            resp = bedrock.invoke_model(modelId=MODEL_ID, body=json.dumps(body))
            LLM.calls += 1
            out = json.loads(resp["body"].read())
            u = out.get("usage", {})
            LLM.in_tokens  += u.get("input_tokens", 0)
            LLM.out_tokens += u.get("output_tokens", 0)
            ans = out["content"][0]["text"].strip().lower().startswith("yes")
            LLM_CACHE[key] = ans
            return ans
        except Exception as e:
            if attempt == retries - 1:
                LLM.errors += 1
                LLM_CACHE[key] = False
                print("LLM fail:", repr(txn_vendor), "|", repr(cand_vendor), "|", e)
                return False
            time.sleep(2 ** attempt)


