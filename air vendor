def vendor_match(txn_vendor, cand_vendor):
    v = brute_match(txn_vendor, cand_vendor)
    if v == "yes":
        return True
    if v == "no":
        return False
    return llm_match(txn_vendor, cand_vendor)


def vendor_filter(txn_vendor, rows, n):
    if not n or n <= 0 or not isinstance(txn_vendor, str):
        return set()
    return {r for r in _as_rows(rows) if vendor_match(txn_vendor, cand_vendor_arr[r])}


