# CELL 3 : LAYER 1  -  BRUTE FORCE  ("yes" / "no" / "unsure")
# ============================================================
FUZZ_YES_CUTOFF = 85    # "soutwes" vs "southwest" type typo yahan pakda jaayega
FUZZ_NO_CUTOFF  = 45

def brute_match(txn_vendor, cand_vendor):
    a, b = _norm(txn_vendor), _norm(cand_vendor)
    if not a or not b:
        return "no"
    if a == b:
        return "yes"

    ca, conf_a = _carrier(txn_vendor)
    cb, conf_b = _carrier(cand_vendor)

    # OTA / parking / non-airline vs airline -> kabhi same nahi
    if (ca == "__nonair__") != (cb == "__nonair__"):
        return "no"
    if ca == "__nonair__" and cb == "__nonair__":
        return "yes" if a == b or a in b or b in a else "unsure"

    # dono carriers identify ho gaye -> yahi 90%+ cases hain
    if ca and cb:
        return "yes" if ca == cb else "no"

    # ek side identify hua, dusra garbled/typo
    if bool(ca) != bool(cb):
        known = ca or cb
        other_raw = cand_vendor if ca else txn_vendor
        other = _strip_noise(_norm(other_raw))
        if not other:
            return "unsure"
        # canonical name ke against typo check: "soutwes" -> "southwest"
        if _HAS_FUZZ:
            best = max(
                fuzz.partial_ratio(known, other),
                fuzz.token_set_ratio(known, other),
                max((fuzz.ratio(n, other) for n in _CANON_INDEX.get(known, ("", [], [], []))[1]),
                    default=0),
            )
            if best >= FUZZ_YES_CUTOFF:
                return "yes"
            if best < FUZZ_NO_CUTOFF:
                return "no"
        else:
            if known.split()[0][:5] in other or other[:5] in known:
                return "yes"
        return "unsure"

    # dono unknown (charter / regional / garbage)
    sa, sb = _strip_noise(a), _strip_noise(b)
    if not sa or not sb:
        return "unsure"
    if sa == sb or sa in sb or sb in sa:
        return "yes"
    if _HAS_FUZZ:
        sc = fuzz.token_set_ratio(sa, sb)
        if sc >= 90:
            return "yes"
        if sc < FUZZ_NO_CUTOFF:
            return "no"
    return "unsure"


