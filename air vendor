class LLMCounter:
    def __init__(self):
        self.calls = 0
        self.cache_hits = 0
        self.in_tokens = 0
        self.out_tokens = 0
        self.errors = 0
        self.t0 = None

    def start(self):
        self.t0 = time.time()

    def report(self, prefix=""):
        el = time.time() - self.t0 if self.t0 else 0
        print(f"{prefix}LLM calls made      : {self.calls}")
        print(f"{prefix}Cache hits (free)   : {self.cache_hits}")
        print(f"{prefix}Input tokens        : {self.in_tokens:,}")
        print(f"{prefix}Output tokens       : {self.out_tokens:,}")
        print(f"{prefix}Errors              : {self.errors}")
        if el:
            print(f"{prefix}Elapsed             : {el/60:.1f} min")


