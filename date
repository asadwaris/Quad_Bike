def one_day_overlaps(a_lo, a_hi, b_lo, b_hi):
    # do inclusive intervals overlap?
    return a_lo <= b_hi and b_lo <= a_hi

def in_range(d, lo, hi):
    return lo <= d <= hi

def filter_overlap(r):
    # sirf naam-mila-par-exact-date-fail wali rows
    if not (r['n_rows'] > 0 and r['n_rows_date'] == 0):
        return []

    d_inv, d_in, d_out = r[DF_INV], r[DF_IN], r[DF_OUT]
    sub = source.loc[r['rows']]

    out = []
    for i, s in sub.iterrows():
        s_inv, s_in, s_out = s[SRC_INV], s[SRC_IN], s[SRC_OUT]

        # df ka range [d_in..d_out]  vs  source ka range [s_in..s_out]
        hit = one_day_overlaps(d_in, d_out, s_in, s_out)

        # df ka koi din source-inv pe (df range me inv aata hai ya df_inv khud)
        hit = hit or in_range(s_inv, d_in, d_out) or (d_inv == s_inv)

        # source ka koi din df-inv pe (df_inv source range me)
        hit = hit or in_range(d_inv, s_in, s_out)

