f2_date_arr  = pd.to_datetime(df2['inv_dt'],    errors='coerce').dt.normalize().to_numpy()
f2_start_arr = pd.to_datetime(df2['startdate'], errors='coerce').dt.normalize().to_numpy()
f2_end_arr   = pd.to_datetime(df2['enddate'],   errors='coerce').dt.normalize().to_numpy()
r1_date_arr  = pd.to_datetime(r1['transactiondate'], errors='coerce').dt.normalize().to_numpy()

def date_filter(d, rows):
    if not rows or pd.isna(d):
        return set()
    matched = set()
    for r in rows:
        # exact invoice date match
        if f2_date_arr[r] == d:
            matched.add(r)
            continue
        # fallback: within [startdate, enddate] window
        s, e = f2_start_arr[r], f2_end_arr[r]
        if not pd.isna(s) and not pd.isna(e) and s <= d <= e:
            matched.add(r)
    return matched

r1['rows_date']   = [date_filter(d, rws) for d, rws in zip(r1_date_arr, r1['rows'])]
r1['n_cand_date'] = r1['rows_date'].map(len)
r1['date_found']  = r1['n_cand_date'] > 0
