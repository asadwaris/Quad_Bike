def _pool(idx, t, head=True):
    if len(t) >= 4:
        return set(idx.get(t[:4] if head else t[-4:], []))
    return {k for key, ks in idx.items()
            if (key.startswith(t) if head else key.endswith(t)) for k in ks}

# ---------- core rule ----------
def ordered_contains(c, toks):
    pos = 0
    for t in toks:
        j = c.find(t, pos)
        if j == -1: return False
        pos = j + len(t)
    return True

def lookup(name):
    toks = owner_toks(name)
    if not toks:
        return {'found': False, 'rows': None, 'n_cand': 0, 'method': None, 'review': False}

    first, last = toks[0], toks[-1]
    pool = _pool(pref_idx, first, True) & _pool(suf_idx, last, False)
    target = ''.join(toks)

    exact, strict = set(), set()
    for k in pool:
        i, c = cands[k]
        if not (c.startswith(first) and c.endswith(last)): continue
        if not ordered_contains(c, toks): continue
        (exact if c == target else strict).add(i)

    hits = exact or strict
    if not hits:
        return {'found': False, 'rows': None, 'n_cand': 0, 'method': 'no_match', 'review': False}
    return {'found': True, 'rows': hits, 'n_cand': len(hits),
            'method': 'exact' if exact else 'middle_name',
            'review': len(toks) == 1 or len(hits) > 1}


