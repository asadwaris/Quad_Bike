# ==================== Layer 1: Brute Force ====================
_NOISE = re.compile(
    r"\b(car rental|car rentals|rent a car|rent-a-car|rentals?|inc|llc|ltd|"
    r"pvt|private|limited|corp|corporation|company|co|holdings|group|the)\b"
)

def _norm(s):
    if not isinstance(s, str):
        return ""
    s = s.lower().replace("*", " ")
    s = re.sub(r"[^a-z0-9\s]", " ", s)
    s = _NOISE.sub(" ", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s

def _core(name):
    n = _norm(name)
    if not n:
        return ""
    first = n.split()[0]
    for brand in ("hertz", "enterprise", "avis", "national", "budget",
                  "alamo", "dollar", "thrifty", "sixt", "payless", "fox"):
        if first.startswith(brand):
            return brand
    return first

def brute_match(txn_vendor, cand_vendor):
    """'yes' (confident) or 'unsure' (LLM decide)."""
    a, b = _norm(txn_vendor), _norm(cand_vendor)
    if not a or not b:
        return "unsure"
    if a == b or a in b or b in a:
        return "yes"
    ca, cb = _core(txn_vendor), _core(cand_vendor)
    if ca and ca == cb:                      # HERTZ CAR RENTAL vs *HERTZ SFO
        return "yes"
    ta = {t for t in a.split() if len(t) >= 4}
    tb = {t for t in b.split() if len(t) >= 4}
    if ta & tb:
        return "yes"
    return "unsure"

# ==================== Layer 2: LLM ====================
_PROMPT = """You are matching car rental vendor names. Two names may refer to the same company even if spelled differently, abbreviated, prefixed with symbols, or with an airport code attached (e.g. "HERTZ CAR RENTAL" and "*HERTZ SFO" are the SAME; "NATIONAL" and "*NATIONALRIC" are the SAME; "Hertz" and "Avis" are DIFFERENT).

Transaction vendor: "{txn}"
Candidate vendor: "{cand}"

Do these refer to the same rental company? Answer with exactly one word: YES or NO."""

@lru_cache(maxsize=20000)
def llm_match(txn_vendor, cand_vendor):
    body = {"anthropic_version": "bedrock-2023-05-31", "max_tokens": 5,
            "temperature": 0,
            "messages": [{"role": "user",
                          "content": _PROMPT.format(txn=txn_vendor, cand=cand_vendor)}]}
    resp = bedrock.invoke_model(modelId=SUPERVISOR_MODEL_ID, body=json.dumps(body))
    out = json.loads(resp["body"].read())
    return out["content"][0]["text"].strip().lower().startswith("yes")

def vendor_match(txn_vendor, cand_vendor):
    if brute_match(txn_vendor, cand_vendor) == "yes":
        return True
    return llm_match(txn_vendor, cand_vendor)

