# ============================================================
# CELL 7 — date columns ko datetime banao (dono taraf)
# ============================================================

# --- apne actual column names yahan daal do ---
DF_IN   = 'hotel_in_date'
DF_OUT  = 'hotel_out_date'
SRC_IN  = 'checkin_date'
SRC_OUT = 'checkout_date'

# yyyy-mm-dd -> datetime (invalid -> NaT)
df[DF_IN]      = pd.to_datetime(df[DF_IN],      format='%Y-%m-%d', errors='coerce')
df[DF_OUT]     = pd.to_datetime(df[DF_OUT],     format='%Y-%m-%d', errors='coerce')
source[SRC_IN]  = pd.to_datetime(source[SRC_IN],  format='%Y-%m-%d', errors='coerce')
source[SRC_OUT] = pd.to_datetime(source[SRC_OUT], format='%Y-%m-%d', errors='coerce')

# NaT check — agar yahan count zyada hai to format/data issue hai
print('df   NaT  :', df[DF_IN].isna().sum(),  df[DF_OUT].isna().sum())
print('source NaT:', source[SRC_IN].isna().sum(), source[SRC_OUT].isna().sum())

# ============================================================
# CELL 8 — date filter: sirf n_rows > 0 wali rows pe
# ============================================================
def filter_date(r):
    if not r['rows']:                       # 0-match rows chhod do
        return []
    sub  = source.loc[r['rows']]
    keep = (sub[SRC_IN] == r[DF_IN]) & (sub[SRC_OUT] == r[DF_OUT])
    return sub.index[keep].tolist()

df['rows_date']   = df.progress_apply(filter_date, axis=1)
df['n_rows_date'] = df['rows_date'].str.len()

print('--- date filter summary ---')
print(f'name-matched rows (n_rows>0)   : {(df["n_rows"] > 0).sum()}')
print(f'survived date filter (>0)      : {(df["n_rows_date"] > 0).sum()}')
print(f'total candidate rows after date: {df["n_rows_date"].sum():,}')
print(df.loc[df['n_rows'] > 0, 'n_rows_date'].describe())
