def date_ok(txn_date, inv_dt, rent_dt, rtrn_dt):
    if pd.isna(txn_date):
        return False
    d = pd.Timestamp(txn_date).normalize()

    # 1. exact vs source invoice date
    inv = pd.Timestamp(inv_dt).normalize() if not pd.isna(inv_dt) else pd.NaT
    if inv is not pd.NaT and d == inv:
        return True

    # 2. fallback: within rent->return window
    s = pd.Timestamp(rent_dt).normalize() if not pd.isna(rent_dt) else pd.NaT
    e = pd.Timestamp(rtrn_dt).normalize() if not pd.isna(rtrn_dt) else pd.NaT
    if s is not pd.NaT and e is not pd.NaT and s <= d <= e:
        return True
    return False


def check_row(row):
    d = row['transactiondate']
    for idx in row['rows']:
        if idx not in df2.index:
            continue
        r = df2.loc[idx]
        if date_ok(d, r['source_inv_dt'], r['car_rent_dt'], r['car_rtrn_dt']):
            return True
    return False


mask = r1['found'] == True
r1.loc[mask, 'date_match'] = r1[mask].apply(check_row, axis=1)
