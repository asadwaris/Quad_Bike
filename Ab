import re, pandas as pd
from collections import defaultdict

STOP = {'mr','mrs','ms','dr','md','jr','sr','ii','iii','the'}

def owner_toks(s):
    if pd.isna(s): return []
    return [t for t in re.sub(r'[^a-z]', ' ', str(s).lower()).split()
            if len(t) > 1 and t not in STOP]

def squash(s):
    return '' if pd.isna(s) else re.sub(r'[^a-z]', '', str(s).lower())

