import numpy as np
import pandas as pd
from itertools import combinations
from joblib import Parallel, delayed

# =====================================================================
# 1. ONE-TIME SETUP  (run ONCE, before the loop — not per row)
# =====================================================================
SPEND_COLS = ["total_air_spend", "total_car_spend", "total_hotel_spend"]
PEER_COLS = [f"peer{i}" for i in range(1, 21)]


def build_lookup(corpsfmerge: pd.DataFrame) -> dict:
    """(corp_id, pos_ctry) is unique -> O(1) lookup instead of df filtering.
    fillna is done ONCE here, not 127k times."""
    df = corpsfmerge.copy()
    df[SPEND_COLS] = df[SPEND_COLS].fillna(0)
    keys = zip(df["corp_id"].astype(str), df["pos_ctry"].astype(int))
    vals = zip(
        df["total_air_spend"].to_numpy(),
        df["total_car_spend"].to_numpy(),
        df["total_hotel_spend"].to_numpy(),
    )
    return dict(zip(keys, vals))


# =====================================================================
# 2. checkcompliance — same semantics as yours, cleaned up
#    (sort-desc + pop replaces repeated argmax+del; '-'.join replaces
#     the manual string loop)
# =====================================================================
def checkcompliance(travelarray):
    # keep positive spends with their original 1-based indices
    pairs = [(v, i + 1) for i, v in enumerate(travelarray) if v > 0]
    if len(pairs) <= 4:
        return "NULL"

    values = [v for v, _ in pairs]
    total = sum(values)
    mx = max(values)

    if mx / total < 0.25:
        return "-".join(str(i) for _, i in pairs)

    if mx / total > 0.25:  # exactly == 0.25 stays NULL, same as your code
        pairs.sort(key=lambda p: p[0], reverse=True)  # biggest first
        while len(pairs) > 5:
            total -= pairs[0][0]          # drop current max
            pairs.pop(0)
            if pairs[0][0] / total < 0.25:
                idx = sorted(i for _, i in pairs)  # original ascending order
                return "-".join(str(i) for i in idx)
    return "NULL"


# =====================================================================
# 3. has_5_combination — BUG FIX: your spend_dictionary was keyed by
#    spend VALUE, so duplicate spends overwrote each other's index.
#    Carrying (value, index) pairs fixes that. Max C(20,5)=15,504
#    combos, cheap enough.
# =====================================================================
def has_5_combination_under_ratio(spend, ratio=0.25):
    pairs = [(v, i + 1) for i, v in enumerate(spend) if v > 0]
    if len(pairs) < 5:
        return "NULL"
    for subset in combinations(pairs, 5):
        s_sum = sum(v for v, _ in subset)
        s_max = max(v for v, _ in subset)
        if s_max < ratio * s_sum:
            return [i for _, i in subset]
    return "NULL"


# =====================================================================
# 4. Per-row worker — NO dataframe touched here. 20 dict lookups only.
# =====================================================================
def compliance_row(row, lookup):
    pos = int(row.pos_ctry)
    airarray, cararray, hotelarray = [], [], []

    for peer in (getattr(row, c) for c in PEER_COLS):
        a, c, h = lookup.get((str(peer), pos), (0, 0, 0))
        airarray.append(a)
        cararray.append(c)
        hotelarray.append(h)

    air_list = checkcompliance(airarray)
    car_list = checkcompliance(cararray)
    htl_list = checkcompliance(hotelarray)

    # fallback: exhaustive 5-combination search
    if htl_list == "NULL":
        upd = has_5_combination_under_ratio(hotelarray)
        if upd != "NULL":
            htl_list = "-".join(str(v) for v in upd)
    if air_list == "NULL":
        upd = has_5_combination_under_ratio(airarray)
        if upd != "NULL":
            air_list = "-".join(str(v) for v in upd)
    if car_list == "NULL":
        upd = has_5_combination_under_ratio(cararray)
        if upd != "NULL":
            car_list = "-".join(str(v) for v in upd)

    # car fallback via hotel ∩ air intersection (same as your logic)
    if car_list == "NULL" and htl_list != "NULL" and air_list != "NULL":
        inter = sorted(
            set(map(int, htl_list.split("-"))) & set(map(int, air_list.split("-")))
        )
        if len(inter) > 4:
            car_list = "-".join(str(v) for v in inter)

    return {
        "corp_id": row.corp_id,
        "pos_ctry": row.pos_ctry,
        "aircompliance": str(air_list),
        "carcompliance": str(car_list),
        "hotelcompliance": str(htl_list),
        "peer_type": row.peertype,
    }


# =====================================================================
# 5. Driver — chunked joblib. Chunking (not delayed-per-row) keeps
#    pickling overhead low.
# =====================================================================
def run_compliance(peers_df, corpsfmerge, n_jobs=-1, chunk_size=8000):
    lookup = build_lookup(corpsfmerge)
    rows = list(peers_df.itertuples(index=False))
    chunks = [rows[i:i + chunk_size] for i in range(0, len(rows), chunk_size)]

    def process_chunk(chunk):
        return [compliance_row(r, lookup) for r in chunk]

    out = Parallel(n_jobs=n_jobs, backend="loky")(
        delayed(process_chunk)(c) for c in chunks
    )
    return pd.DataFrame([r for chunk in out for r in chunk])


