def lookup(name):
    toks = owner_toks(name)
    if not toks:
        return {'found': False, 'rows': None, 'n_cand': 0,
                'method': None, 'review': False, 'extra': None}

    first, last = toks[0], toks[-1]
    target = ''.join(toks)
    pool = _pool(pref_idx, first, True)          # only anchor the search, not the match
    if len(toks) > 1:
        pool |= {k for k in range(len(cands)) if False}   # no-op; keep pool = first-anchored

    tiers = {0: set(), 1: set(), 2: set()}
    extras = {}
    for k in pool:
        i, c = cands[k]
        if not c.startswith(first):
            continue
        pos, ok = 0, True
        for t in toks:
            j = c.find(t, pos)
            if j == -1: ok = False; break
            pos = j + len(t)
        if not ok:
            continue
        tail = len(c) - pos                       # chars left after the last name
        tier = 0 if c == target else (1 if tail == 0 else 2)
        tiers[tier].add(i)
        extras.setdefault(i, c[pos:])

    for tier, label in [(0, 'exact'), (1, 'inner_extra'), (2, 'trailing_extra')]:
        if tiers[tier]:
            hits = tiers[tier]
            return {'found': True, 'rows': hits, 'n_cand': len(hits),
                    'method': label,
                    'review': tier == 2 or len(hits) > 1 or len(toks) == 1,
                    'extra': sorted({extras[i] for i in hits})[:3]}

    return {'found': False, 'rows': None, 'n_cand': 0,
            'method': 'no_match', 'review': False, 'extra': None}
