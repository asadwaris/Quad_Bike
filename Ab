def lookup(name):
    toks = set(norm_tokens(name))
    if not toks: return None
    sets = [index.get(t) for t in toks]
    if any(s is None for s in sets): return None      # koi token file2 me hai hi nahi
    sets.sort(key=len)                                 # rarest token pehle
    hits = set(sets[0])
    for s in sets[1:]:
        hits &= s
        if not hits: return None
    return hits

