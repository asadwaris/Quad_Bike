    sub['tempindustryrank'] = (sub['industry'] == industrycheck).astype(int).rank(ascending=True)

    # --- total rank by peer type ---
    if peertypethis == 'Others Like Me':
        sub['totalrank'] = (sub['tempindustryrank']
                            + sub['tempposrank']
