def tok_hit(t, toks, blob, fullcat):
    if t in toks: return 3                      # exact
    if len(t) < 4: return 0
    for x in toks:
        if len(x) < 4: continue
        if t.startswith(x) or x.startswith(t): return 2      # truncation
        if common_prefix_len(t, x) >= 5: return 2            # gopal / gopalakrishnan
        if fuzz.ratio(t, x) >= 88: return 1                  # typo
    if t in blob or t in fullcat: return 2                   # concatenated
    if fuzz.partial_ratio(t, fullcat) >= 92: return 1
    return 0

def brute_lookup(name):
    toks = norm_tokens(name)
    if not toks:
        return {'found': False, 'rows': None, 'n_cand': 0, 'score': 0}
    hits, best = [], 0
    for i, (t2, blob, fullcat) in enumerate(f2_rows):
