# ==================== Layer 2: LLM ====================
_PROMPT = """You are matching car rental vendor names. Two names may refer to the same company even if spelled differently, abbreviated, or with extra words (e.g. "Enterprise" and "Enterprise Rent-A-Car" are the SAME; "National" and "National Car Rental" are the SAME; "Hertz" and "Avis" are DIFFERENT).

Transaction vendor: "{txn}"
Candidate vendor: "{cand}"

Do these refer to the same rental company? Answer with exactly one word: YES or NO."""

@lru_cache(maxsize=20000)
def llm_match(txn_vendor, cand_vendor):
    body = {
        "anthropic_version": "bedrock-2023-05-31",
        "max_tokens": 5,
        "temperature": 0,
        "messages": [{"role": "user",
                      "content": _PROMPT.format(txn=txn_vendor, cand=cand_vendor)}],
    }
    resp = bedrock.invoke_model(modelId=SUPERVISOR_MODEL_ID, body=json.dumps(body))
    out = json.loads(resp["body"].read())
    return out["content"][0]["text"].strip().lower().startswith("yes")

def vendor_match(txn_vendor, cand_vendor):
    if brute_match(txn_vendor, cand_vendor) == "yes":
        return True
    return llm_match(txn_vendor, cand_vendor)

