    sub['tempdomesticrank']  = (sub['economy_and_domestic_percent'] - self_row['economy_and_domestic_percent']).abs().fillna(9999999).rank()
    sub['tempnemployeerank'] = (sub['numberofemployees'] - self_row['numberofemployees']).abs().fillna(0).rank()

    # --- industry handling ---
    industrycheck = self_row['industry']
    if peertypethis != 'Others Like Me' and 'Industry' in peertypethis:
