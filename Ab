def match_toks(toks, c):
    """tumhare check() ka core — sirf boolean, ordered subsequence containment"""
    pos = 0
    for t in toks:
        j = c.find(t, pos)
        if j == -1:
            return False
        pos = j + len(t)
    return True


def find_rows(owner):
    """owner ke liye saare matching source index labels"""
    toks = owner_toks(owner)
    if not toks:
        return []
    key  = max(toks, key=len)                      # sabse selective token se prefilter
    cand = src_sq[src_sq.str.contains(key, regex=False)]
    return [i for i, c in cand.items() if match_toks(toks, c)]


