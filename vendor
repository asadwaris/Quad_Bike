def _brand(nrm):
    """normalized string se canonical brand nikalta hai, warna ''."""
    if not nrm:
        return ""
    padded = f" {nrm} "
    for canon, pats in _BRAND_PATTERNS:
        for p in pats:
            if p in padded:
                return canon
    return ""

def _disc(nrm, brand):
    """brand hatane ke baad bache huye discriminator tokens (city/airport/street)."""
    s = nrm
    if brand:
        for canon, pats in _BRAND_PATTERNS:
            if canon == brand:
                for p in pats:
                    s = s.replace(p, " ")
                break
        s = s.replace(brand, " ")
    s = _strip_noise(s)
    return {t for t in s.split() if len(t) >= 3 and not t.isdigit()}

