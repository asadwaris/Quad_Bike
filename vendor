_NOISE = re.compile(
    r"\b(hotel|hotels|motel|inn|inns|resort|resorts|suites|suite|lodge|lodging|"
    r"house|guest ?house|hostel|spa|and|the|of|by|at|a|an|"
    r"llc|inc|ltd|pvt|private|limited|corp|corporation|company|co|holdings|group|"
    r"international|intl|hospitality|properties|property|management|mgmt)\b"
)
_PAY = re.compile(r"\b(sp|sq|tst|pos|pmt|payment|purchase|debit|credit|card|www|com|http[s]?)\b")

def _norm(s):
    if not isinstance(s, str):
        return ""
    s = s.lower().replace("*", " ").replace("-", " ").replace("/", " ")
    s = re.sub(r"[^a-z0-9\s]", " ", s)
    s = _PAY.sub(" ", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s

def _strip_noise(s):
    s = _NOISE.sub(" ", s)
    return re.sub(r"\s+", " ", s).strip()

