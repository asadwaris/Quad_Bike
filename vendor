# CELL 4 : LAYER 2  -  LLM (counted)
# ============================================================
_PROMPT = """You are matching hotel names from a credit card transaction against a hotel name from an invoice system.

The same property can look different: abbreviations, missing sub-brand, airport or city codes appended, payment-processor prefixes, franchisee legal names.

Rules:
- Same brand AND same property/location = SAME
- Same brand but clearly DIFFERENT city or property = DIFFERENT
- Different sub-brands of the same parent (e.g. "Courtyard by Marriott" vs "JW Marriott") = DIFFERENT
- An online travel agency (Expedia, Booking.com) is NEVER the same as a hotel property

Transaction hotel: "{txn}"
Candidate hotel:   "{cand}"

Do these refer to the same hotel property? Answer with exactly one word: YES or NO."""

def _cache_key(a, b):
    na, nb = _norm(a), _norm(b)
    return (na, nb) if na <= nb else (nb, na)

def llm_match(txn_vendor, cand_vendor, retries=3):
    key = _cache_key(txn_vendor, cand_vendor)
    if key in LLM_CACHE:
        LLM.cache_hits += 1
        return LLM_CACHE[key]

    body = {"anthropic_version": "bedrock-2023-05-31", "max_tokens": 5,
            "temperature": 0,
            "messages": [{"role": "user",
                          "content": _PROMPT.format(txn=txn_vendor, cand=cand_vendor)}]}

    for attempt in range(retries):
        try:
            resp = bedrock.invoke_model(modelId=MODEL_ID, body=json.dumps(body))
            LLM.calls += 1                       # <-- yahan ginti hoti hai
            out = json.loads(resp["body"].read())
            u = out.get("usage", {})
            LLM.in_tokens  += u.get("input_tokens", 0)
            LLM.out_tokens += u.get("output_tokens", 0)
            ans = out["content"][0]["text"].strip().lower().startswith("yes")
            LLM_CACHE[key] = ans
            return ans
        except Exception as e:
            if attempt == retries - 1:
                LLM.errors += 1
                LLM_CACHE[key] = False           # fail-safe: no match
                print("LLM fail:", repr(txn_vendor), "|", repr(cand_vendor), "|", e)
                return False
            time.sleep(2 ** attempt)


