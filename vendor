# CELL 5 : DRY RUN  -  kitne LLM calls lagenge, PEHLE pata karo
# ============================================================
def _as_rows(v):
    """set / list / str-from-csv sab handle kar leta hai."""
    if isinstance(v, (set, list, tuple)):
        return list(v)
    if isinstance(v, str) and v.strip():
        return [int(x) for x in re.findall(r"\d+", v)]
    return []

cand_vendor_arr = df2[CAND_VENDOR_COL].to_numpy()

def build_workload(r1):
    """Har (txn, cand) pair pe brute force chalao, unsure pairs collect karo."""
    stats = Counter()
    unsure_pairs = set()      # unique normalized pairs -> yahi LLM calls honge
    pair_examples = {}

    for txn, rows, n in zip(r1[TXN_VENDOR_COL], r1[OVERLAP_ROWS_COL], r1[OVERLAP_N_COL]):
        if not n or n <= 0:
            stats["skipped_no_overlap"] += 1
            continue
        for r in _as_rows(rows):
            cand = cand_vendor_arr[r]
            v = brute_match(txn, cand)
            stats[f"brute_{v}"] += 1
            stats["total_comparisons"] += 1
            if v == "unsure":
                k = _cache_key(txn, cand)
                if k not in LLM_CACHE:
                    unsure_pairs.add(k)
                    pair_examples.setdefault(k, (txn, cand))
    return stats, unsure_pairs, pair_examples


