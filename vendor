# ============================================================
# CELL 3 : LAYER 1  -  BRUTE FORCE  ("yes" / "no" / "unsure")
# ============================================================
FUZZ_NO_CUTOFF  = 45    # isse neeche = definitely different, LLM mat bhej
FUZZ_YES_CUTOFF = 92    # isse upar  = definitely same

def brute_match(txn_vendor, cand_vendor):
    a, b = _norm(txn_vendor), _norm(cand_vendor)
    if not a or not b:
        return "no"
    if a == b:
        return "yes"

    ba, bb = _brand(a), _brand(b)

    # dono ke brand pata hai
    if ba and bb:
        if ba != bb:
            return "no"                       # Hilton vs Hyatt -> LLM ki zarurat nahi
        da, db = _disc(a, ba), _disc(b, bb)
        if not da or not db:
            return "yes"                      # ek side sirf brand hai
        if da & db:
            return "yes"                      # same brand + same city/airport token
        return "unsure"                       # same brand, alag location -> LLM decide kare

    # sirf ek side ka brand pata hai -> dusra side independent/garbled
    if bool(ba) != bool(bb):
        known = ba or bb
        other = b if ba else a
        if known.split()[0] in other:
            return "yes"
        if _HAS_FUZZ and fuzz.token_set_ratio(a, b) < FUZZ_NO_CUTOFF:
            return "no"
        return "unsure"

    # dono independent hotels
    sa = _strip_noise(a)
    sb = _strip_noise(b)
    if not sa or not sb:
        return "unsure"
    if sa == sb or sa in sb or sb in sa:
        return "yes"
    ta = {t for t in sa.split() if len(t) >= 4}
    tb = {t for t in sb.split() if len(t) >= 4}
    if ta and tb:
        ov = len(ta & tb) / min(len(ta), len(tb))
        if ov >= 0.75:
            return "yes"
    if _HAS_FUZZ:
        sc = fuzz.token_set_ratio(sa, sb)
        if sc >= FUZZ_YES_CUTOFF:
            return "yes"
        if sc < FUZZ_NO_CUTOFF:
            return "no"
    return "unsure"


